*&---------------------------------------------------------------------*
*& Report ZINTERACTIVE_REPORT_TASK_2
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
REPORT ZINTERACTIVE_REPORT_SK2.

TABLES: MARA.

TYPES: BEGIN OF STR_MARA,
         MATNR TYPE MARA-MATNR,
         ERNAM TYPE MARA-ERNAM,
         MTART TYPE MARA-MTART,
         MBRSH TYPE MARA-MBRSH,
         MATKL TYPE MARA-MATKL,
         MEINS TYPE MARA-MEINS,
       END OF STR_MARA.

TYPES: BEGIN OF STR_MAKT,
  MATNR TYPE MAKT-MATNR,
  MAKTX TYPE MAKT-MAKTX,
  END OF STR_MAKT.

DATA: IT_MARA TYPE TABLE OF STR_MARA,
      WA_MARA TYPE STR_MARA,
      IT_MAKT TYPE TABLE OF STR_MAKT,
      WA_MAKT TYPE STR_MAKT.

SELECTION-SCREEN BEGIN OF BLOCK B1 WITH FRAME TITLE TEXT-001.
  SELECT-OPTIONS: P_MATNR FOR MARA-MATNR.
  " PARAMETERS: P_MTYPE TYPE MARA-MTART.
  " PARAMETERS: P_IND TYPE MARA-MBRSH.
SELECTION-SCREEN END OF BLOCK B1.

TOP-OF-PAGE.
  WRITE:   'MATERIAL NO' COLOR 5,
        40 'USER NO' COLOR 3,
        50 'MAT TYPE' COLOR 2,
        60 'IND SEC',
        70 'MAT GRUP',
        80 'UNIT'.
  ULINE.
  TOP-OF-PAGE DURING LINE-SELECTION.
  WRITE: 'MATERIAL NO',
          40 'DISCRIPTION'.
    ULINE.
    TOP-OF-PAGE DURING LINE-SELECTION.
  WRITE: 'THIS SCREEN IS UNDER CONSTRUCTION'.
    ULINE.

START-OF-SELECTION.
  SELECT MATNR
         ERNAM
         MTART
         MBRSH
         MATKL
         MEINS
    FROM MARA INTO CORRESPONDING FIELDS OF TABLE IT_MARA
    WHERE MATNR IN P_MATNR.

  LOOP AT IT_MARA INTO WA_MARA.
    WRITE: / WA_MARA-MATNR COLOR 4,
          40 WA_MARA-ERNAM,
          50 WA_MARA-MTART,
          60 WA_MARA-MBRSH,
          70 WA_MARA-MATKL,
          80 WA_MARA-MEINS.
    HIDE WA_MARA.
  ENDLOOP.

  AT LINE-SELECTION.
    CASE:SY-LSIND.
    WHEN:1.
    SELECT
      MATNR
      MAKTX
      FROM MAKT INTO TABLE IT_MAKT
      WHERE MATNR = WA_MARA-MATNR.

LOOP AT IT_MAKT INTO WA_MAKT.
  WRITE: / WA_MAKT-MATNR,
          40 WA_MAKT-MAKTX.
  ENDLOOP.
  WHEN: 2.
    WRITE:'SCREEN IS UNDER CONSTRUCTION'.
ENDCASE.