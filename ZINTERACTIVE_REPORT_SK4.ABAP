*&---------------------------------------------------------------------*
*& Report ZINTERACTIVE_REPORT_TASK_4
*&---------------------------------------------------------------------*
REPORT ZINTERACTIVE_REPORT_TASK_4.

TABLES: MARA,MARC,T001L,MBEW.

TYPES: BEGIN OF STR_MARA,
*       MARA
         MATNR TYPE MARA-MATNR,
         ERSDA TYPE MARA-ERSDA,
         ERNAM TYPE MARA-ERNAM,
         LAEDA TYPE MARA-LAEDA,
         AENAM TYPE MARA-AENAM,
         VPSTA TYPE MARA-VPSTA,
         PSTAT TYPE MARA-PSTAT,
         LVORM TYPE MARA-LVORM,
         MTART TYPE MARA-MTART,

*       MARC
         WERKS TYPE MARC-WERKS,
         BWTTY TYPE MARC-BWTTY,
         XCHAR TYPE MARC-XCHAR,

*       Too1l
         LGORT TYPE T001L-LGORT,
         LGOBE TYPE T001L-LGOBE,
         SPART TYPE T001L-SPART,
         XLONG TYPE T001L-XLONG,

*       MBEW
         BWKEY TYPE MBEW-BWKEY,
         BWTAR TYPE MBEW-BWTAR,
         LBKUM TYPE MBEW-LBKUM,
       END OF STR_MARA.

DATA: IT_MARA TYPE TABLE OF STR_MARA,
      WA_MARA TYPE STR_MARA.

SELECTION-SCREEN BEGIN OF BLOCK B1 WITH FRAME TITLE TEXT-001.

PARAMETERS: P_MATNR TYPE MARA-MATNR.
*      P_ERSDA TYPE MARA-ERSDA,
*      P_ERNAM TYPE MARA-ERNAM,
*      P_LAEDA TYPE MARA-LAEDA.

SELECTION-SCREEN END OF BLOCK B1.

START-OF-SELECTION.
  SELECT
  MARA~MATNR
  MARA~ERSDA
  MARA~ERNAM
  MARA~LAEDA
  MARA~AENAM
  MARA~VPSTA
  MARA~PSTAT
  MARA~LVORM
  MARA~MTART

  MARC~WERKS
  MARC~BWTTY
  MARC~XCHAR

  T001L~LGORT
  T001L~LGOBE
  T001L~SPART
  T001L~XLONG

  MBEW~BWKEY
  MBEW~BWTAR
  MBEW~LBKUM

  FROM MARA
  INNER JOIN MARC ON MARA~MATNR = MARC~MATNR
  INNER JOIN T001L ON MARC~WERKS = T001L~WERKS
  INNER JOIN MBEW ON MBEW~MATNR = MARA~MATNR
  INTO TABLE IT_MARA

  WHERE MARA~MATNR = P_MATNR.


  LOOP AT IT_MARA INTO WA_MARA.
   WRITE: / WA_MARA-MATNR,
             WA_MARA-ERSDA,
             WA_MARA-ERNAM,
             WA_MARA-LAEDA,
             WA_MARA-AENAM,
             WA_MARA-VPSTA,
             WA_MARA-PSTAT,
             WA_MARA-LVORM,
             WA_MARA-MTART,

             WA_MARA-WERKS,
             WA_MARA-BWTTY,
             WA_MARA-XCHAR,

             WA_MARA-LGORT,
             WA_MARA-LGOBE,
             WA_MARA-SPART,
             WA_MARA-XLONG,

             WA_MARA-BWKEY,
             WA_MARA-BWTAR,
             WA_MARA-LBKUM.
  ENDLOOP.
  